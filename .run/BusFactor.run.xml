<?xml version="1.0" encoding="UTF-8"?>
<component name="ProjectRunConfigurationManager">
  <!-- Shared IntelliJ run configurations — plain Shell Script type, no plugins required.

       Start BusFactor (db + api)  THE one to run: starts FalkorDB, then the API,
                                   which also serves the built web UI.
                                   Open http://localhost:8000 when it's up.
       Web dev server (vite)       optional — live-reloading UI on :5173 (/api proxied)
       FalkorDB (db only)          optional — just the database container -->
  <configuration default="false" name="Start BusFactor (db + api)" type="ShConfigurationType" factoryName="Shell Script">
    <option name="SCRIPT_TEXT" value="echo 'BusFactor -> http://localhost:8000'; make up; cd agent &amp;&amp; export PYTHONUNBUFFERED=1 &amp;&amp; exec ./.venv/bin/python -m uvicorn busfactor.api:app --port 8000 --log-level warning" />
    <option name="INDEPENDENT_SCRIPT_PATH" value="true" />
    <option name="SCRIPT_PATH" value="" />
    <option name="SCRIPT_OPTIONS" value="" />
    <option name="INDEPENDENT_SCRIPT_WORKING_DIRECTORY" value="true" />
    <option name="SCRIPT_WORKING_DIRECTORY" value="$PROJECT_DIR$" />
    <option name="INDEPENDENT_INTERPRETER_PATH" value="true" />
    <option name="INTERPRETER_PATH" value="/bin/zsh" />
    <option name="INTERPRETER_OPTIONS" value="" />
    <option name="EXECUTE_IN_TERMINAL" value="false" />
    <option name="EXECUTE_SCRIPT_FILE" value="false" />
    <envs />
    <method v="2" />
  </configuration>
  <configuration default="false" name="Web dev server (vite)" type="ShConfigurationType" factoryName="Shell Script">
    <option name="SCRIPT_TEXT" value="cd web &amp;&amp; npm run dev" />
    <option name="INDEPENDENT_SCRIPT_PATH" value="true" />
    <option name="SCRIPT_PATH" value="" />
    <option name="SCRIPT_OPTIONS" value="" />
    <option name="INDEPENDENT_SCRIPT_WORKING_DIRECTORY" value="true" />
    <option name="SCRIPT_WORKING_DIRECTORY" value="$PROJECT_DIR$" />
    <option name="INDEPENDENT_INTERPRETER_PATH" value="true" />
    <option name="INTERPRETER_PATH" value="/bin/zsh" />
    <option name="INTERPRETER_OPTIONS" value="" />
    <option name="EXECUTE_IN_TERMINAL" value="false" />
    <option name="EXECUTE_SCRIPT_FILE" value="false" />
    <envs />
    <method v="2" />
  </configuration>
  <configuration default="false" name="FalkorDB (db only)" type="ShConfigurationType" factoryName="Shell Script">
    <option name="SCRIPT_TEXT" value="make up" />
    <option name="INDEPENDENT_SCRIPT_PATH" value="true" />
    <option name="SCRIPT_PATH" value="" />
    <option name="SCRIPT_OPTIONS" value="" />
    <option name="INDEPENDENT_SCRIPT_WORKING_DIRECTORY" value="true" />
    <option name="SCRIPT_WORKING_DIRECTORY" value="$PROJECT_DIR$" />
    <option name="INDEPENDENT_INTERPRETER_PATH" value="true" />
    <option name="INTERPRETER_PATH" value="/bin/zsh" />
    <option name="INTERPRETER_OPTIONS" value="" />
    <option name="EXECUTE_IN_TERMINAL" value="false" />
    <option name="EXECUTE_SCRIPT_FILE" value="false" />
    <envs />
    <method v="2" />
  </configuration>
</component>
