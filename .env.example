# BusFactor — environment. Copy to .env and edit.
# Every knob the system reads lives in agent/busfactor/config.py; nothing else
# is hardcoded at runtime. All values below are the built-in defaults.

# ---- FalkorDB -------------------------------------------------------------
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=
MAIN_GRAPH=main

# ---- data locations ---------------------------------------------------------
# The pinned demo snapshot (committed) and where user indexes land.
# SNAPSHOT_PATH=./data/snapshot.json
# SOURCE_DIR=./data/source
# SNAPSHOTS_DIR=./data/snapshots
# RAW_DIR=./data/raw
# Set to 1 to auto-load the pinned snapshot on API startup.
AUTO_INGEST=0

# ---- LLM router (optional) --------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint. OpenCode Console (inference
# gateway) free models work as-is — grab a key at opencode.ai/console and use
# one of the "-free" model ids. The model is only ever asked to route a
# question to one of the 8 tools; it never writes Cypher and never produces
# numbers (see README: the LLM routes, the graph answers, the validator
# checks). Unset => fully deterministic regex router; the product works
# completely without it.
# LLM_BASE_URL=https://opencode.ai/inference/openai/v1
# LLM_MODEL=mimo-v2.6-flash-free   # or: glm-5.3-flash-free, space-bunny-free, big-pickle
# LLM_API_KEY=

# ---- GitHub (optional) -------------------------------------------------------
# Needed for private repo indexing and PR/review enrichment. Never stored in
# any graph. Live Actions writes additionally require ACTIONS_REPO, which
# pins the one repo they may ever target (README I8).
# GITHUB_TOKEN=
# ACTIONS_REPO=your-org/your-repo

# ---- product constants ---------------------------------------------------------
# Coverage floor K: below this a module is "thin".
COVERAGE_FLOOR=2
