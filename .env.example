# BusFactor environment. Copy to `.env` and adjust.

# --- FalkorDB -------------------------------------------------------------
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=

# --- Data ---------------------------------------------------------------
# Defaults to data/snapshot.json; override to point at another pinned snapshot.
# SNAPSHOT_PATH=
# Load the snapshot into FalkorDB automatically when the API starts (used by docker compose).
AUTO_INGEST=0

# --- LLM (optional) -------------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint. Without it, the agent runs
# its deterministic template planner — the demo works either way.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=

# --- GitHub (optional) ----------------------------------------------------
# Used only to enrich the snapshot with PR review data (`make ingest-live`)
# and to open handover issues/runbook PRs in live mode (`/api/actions`).
# Fine-grained token with read access to public repos (or a classic token, read-only).
# GITHUB_TOKEN=

# Operator-owned repo for live actions (owner/name). Preview mode needs nothing.
# ACTIONS_REPO=
