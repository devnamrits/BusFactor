# BusFactor — environment. Copy to .env and edit.
# Every knob the system reads lives in agent/busfactor/config.py; nothing else
# is hardcoded at runtime. All values below are the built-in defaults.

# ---- FalkorDB -------------------------------------------------------------
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=
MAIN_GRAPH=main

# ---- data locations ---------------------------------------------------------
# The pinned demo snapshot (committed) and where user indexes land.
# SNAPSHOT_PATH=./data/snapshot.json
# SOURCE_DIR=./data/source
# SNAPSHOTS_DIR=./data/snapshots
# RAW_DIR=./data/raw
# Set to 1 to auto-load the pinned snapshot on API startup.
AUTO_INGEST=0

# ---- LLM router (optional) --------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint. The model is only ever asked
# to route a question to one of the 9 tools; it never writes Cypher and never
# produces numbers (see README: the LLM routes, the graph answers, the
# validator checks). Unset => fully deterministic regex router; the product
# works completely without it; any failure falls back automatically.
#
# Zero-cost setup that works from a normal app: an OpenRouter ":free" model
# (grab a key at openrouter.ai/settings/keys). Caveat we verified: OpenCode
# Console's free-tier models only answer requests from inside the OpenCode
# client (403 FreeTierError for other callers), so they can't be used here.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# LLM_API_KEY=
#
# Paid alternative that is still negligible for routing (cents per week):
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# LLM_API_KEY=

# ---- GitHub (optional) -------------------------------------------------------
# Needed for private repo indexing and PR/review enrichment. Never stored in
# any graph. Live Actions writes additionally require ACTIONS_REPO, which
# pins the one repo they may ever target (README I8).
# GITHUB_TOKEN=
# ACTIONS_REPO=your-org/your-repo

# ---- product constants ---------------------------------------------------------
# Coverage floor K: below this a module is "thin".
COVERAGE_FLOOR=2
# Fail-fast net for absurd histories: a window with more commits than this
# refuses to build (default 250,000 — raise it if you mean it).
# BUSFACTOR_MAX_COMMITS=250000
